-- Report §8.5.3, Table 9.2 (second worked predicate: XOR chain + if-branch), Stage 9b.
-- Source: RevLib (www.revlib.org), function "Simple ALU" (simple_alu, function_details.php?id=234),
-- SyReC file https://www.revlib.org/doc/func/simple_alu_234.src [WOD:2010]
-- (603 bytes, Last-Modified 2010-12-22, SHA-256 441a326a170472f8b025ba6199210472d690ed6c1e93950d540564022001cb38):
--   if (op = 0) then x0 ^= (x1 + x2) else if (op = 1) then x0 ^= (x1 - x2)
--   else if (op = 2) then x0 ^= (x1 * x2) else x0 ^= (x1 ^ x2)
-- Single output: bit 1 of x0 (`out`, so x0 starts at 0). Its cone has 6 inputs for every bit
-- width w >= 2 (bit 1 of +, -, *, ^ mod 2^w reads bits 0 and 1 only). Input layout:
-- x[0] = op.0, x[1] = op.1, x[2] = x1.0, x[3] = x1.1, x[4] = x2.0, x[5] = x2.1 (bit 0 = LSB).
-- Transcription (DECISIONS.md 2026-10-25, Stage 9b decision 2): the if-chain on `op = k` -> `if`
-- with `op = k` as a conjunction of literals on op.0, op.1; bit 1 of x1 + x2 is the XOR chain
-- x1.1 xor x2.1 xor carry (carry = x1.0 and x2.0); of x1 - x2, x1.1 xor x2.1 xor borrow
-- (borrow = not x1.0 and x2.0); of x1 * x2, (x1.1 and x2.0) xor (x1.0 and x2.1); of x1 ^ x2,
-- x1.1 xor x2.1.
fn simple_alu_x0_1(x: Vec Bool 6) -> Bool {
  let op0 = idx(x, 0) in
  let op1 = idx(x, 1) in
  let a0 = idx(x, 2) in
  let a1 = idx(x, 3) in
  let b0 = idx(x, 4) in
  let b1 = idx(x, 5) in
  if (not op1) and (not op0) then a1 xor b1 xor (a0 and b0)
  else if (not op1) and op0 then a1 xor b1 xor ((not a0) and b0)
  else if op1 and (not op0) then (a1 and b0) xor (a0 and b1)
  else a1 xor b1
}
