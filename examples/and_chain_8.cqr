-- Report §6.1.3, Table 2: a chain of c∧ = 8 ANDs (left-associated), for the Bennett budgets
-- `cqr synthesize examples/and_chain_8.cqr --amax k`, k ∈ {8, 4, 2, 1}.
fn and_chain_8(x: Vec Bool 9) -> Bool {
  idx(x, 0) and idx(x, 1) and idx(x, 2) and idx(x, 3) and idx(x, 4)
    and idx(x, 5) and idx(x, 6) and idx(x, 7) and idx(x, 8)
}
