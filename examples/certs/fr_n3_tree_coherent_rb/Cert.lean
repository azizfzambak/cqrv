/-- The synthesized oracle of `net` in mode `coherent`. -/
def oracleCircuit : Circuit := okPayload (synthesizeOracle net .coherent)

/-- The coherent oracle certificate (PHASE2_SPEC.md §A.0.1): Lemma 6.3.2 in mode `coherent`
fills its restoration field. -/
def oracle : OracleCertCoh 3 where
  N := net
  C := oracleCircuit
  hn := rfl
  hC := except_eq_ok_okPayload (synthesizeOracle net .coherent) (by decide +kernel)
  hWF := by decide +kernel

