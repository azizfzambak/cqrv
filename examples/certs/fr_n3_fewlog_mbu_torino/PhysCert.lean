  N := net
  C := oracleCircuit
  hn := rfl
  hC := except_eq_ok_okPayload (synthesizeOracle net) (by decide +kernel)
  hWF := by decide +kernel

/-- The few-ancilla MCZ on 3 qubits (Stage 12b candidate B; `mczFewK` is `mczFew` with a
kernel-evaluable sort, `mczFew_eq_K`). -/
def mczCircuit : Circuit := okPayload (mczFewK 3 .logDepth)

theorem mcz_ok : mczFew 3 .logDepth = .ok mczCircuit := by
  rw [mczFew_eq_K]
  exact except_eq_ok_okPayload (mczFewK 3 .logDepth) (by decide +kernel)

/-- The few-ancilla diffusion on 3 qubits (§8.2). -/
def diffCircuit : Circuit := diffusionCircuit 3 mczCircuit

theorem diff_ok : diffusionFew 3 .logDepth = .ok diffCircuit := diffusionFew_ok_of mcz_ok

/-- The hash link: the Grover circuit of `groverCircuitFew` is `groverCircuitOf` the oracle and
the diffusion; the kernel compares it with `emitted`. -/
theorem emitted_ok : groverCircuitFew net 3 2 .logDepth = .ok emitted :=
  (groverCircuitFew_ok_of oracle.hn oracle.hC mcz_ok).trans (congrArg Except.ok (by decide +kernel))

/-- Report §8.2 (Stage 14a) — the solution count, decided by the kernel: `Network.countSat`
evaluates `net` on all 2^3 inputs; `Network.countSat_eq_card` identifies that count with the
cardinality of the statement. -/
theorem hM_count : (Finset.univ.filter fun x => Network.pred net 3 x = true).card = 1 := by
  rw [← Network.countSat_eq_card]
  decide +kernel

/-- Report §8.4.1, §8.4.4 — the certificate: the emitted circuit realizes the search spec of
`net` with δ = 7/128 exactly within its measured grade, and restores its ancillae;
the solution count is decided by the kernel (`hM_count`). -/
theorem cert :
    RealizesExact (SearchSpec (Network.pred net 3)) (basisPOVM 3) (groverChannel 3 emitted)
        (7 / 128 : ℝ) ⟨5, 86, 24, 2⟩ ∧
      AncRestore 3 2 emitted (groverOp (Network.pred net 3) ^ 2 * hadamardU 3) :=
  grover_certificate_few_all oracle (by decide) diff_ok emitted_ok delta_eq grade_eq nAnc_eq
    hM_count

