/-! ## The assembled circuit -/

/-- The emitted circuit (IR, §6.1.4): the blocks assembled with their multiplicities
(`assembleCounting`); QIR / OpenQASM 3 and `circuit_hash` are of this circuit. -/
def emitted : Circuit := assembleCounting h_layer [cg_0, cg_1, cg_2, cg_3] inverse

theorem emitted_def : emitted = assembleCounting h_layer [cg_0, cg_1, cg_2, cg_3] inverse := rfl

/-- The hash link: `countingCircuit` on `net` is the assembled circuit, by the library theorem
`countingCircuit_of_blocks` and the block links (no kernel evaluation of the whole circuit). -/
theorem emitted_ok : countingCircuit net 8 4 none .tree .mbu = .ok emitted := by
  have h := countingCircuit_of_blocks (N := net) (n := 8) (m := 4) none (shape := .tree)
    (mode := .mbu) (bs := [cg_0, cg_1, cg_2, cg_3]) (by decide) rfl fun j hj =>
    match j, hj with
      | 0, _ => cg_0_ok
      | 1, _ => cg_1_ok
      | 2, _ => cg_2_ok
      | 3, _ => cg_3_ok
      | _ + 4, h => absurd h (by omega)
  rwa [h_layer_ok, inverse_ok, ← emitted_def] at h

/-- Every controlled iterate is on the data register of the Hadamard layer. -/
theorem blocks_nData : ∀ b ∈ [cg_0, cg_1, cg_2, cg_3], b.nData = h_layer.nData := by
  intro b hb
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hb
  rcases hb with rfl | rfl | rfl | rfl <;> rfl

/-- Every controlled iterate ends with no live ancilla. -/
theorem blocks_liveEnd : ∀ b ∈ [cg_0, cg_1, cg_2, cg_3], b.liveEnd = 0 := by
  intro b hb
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hb
  rcases hb with rfl | rfl | rfl | rfl
  exacts [cg_0_liveEnd, cg_1_liveEnd, cg_2_liveEnd, cg_3_liveEnd]

/-- PHASE2_SPEC.md §A.4 (amendments before Stage 20b3, (2)), report §3.1.4 — the composed grade
bound: `grade_assembleCounting_le` with the blocks' `grade_eq`, the arithmetic by `decide`. -/
theorem grade_le : Synthesis.grade emitted ≤ ⟨20, 1388, 660, 8⟩ := by
  have h := grade_assembleCounting_le h_layer [cg_0, cg_1, cg_2, cg_3] inverse blocks_nData rfl
    h_layer_liveEnd blocks_liveEnd
  simp only [List.zipIdx_cons, List.zipIdx_nil, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Nat.reducePow, h_layer_grade_eq, cg_0_grade_eq, cg_1_grade_eq, cg_2_grade_eq, cg_3_grade_eq, inverse_grade_eq] at h
  rw [emitted_def]
  exact le_trans h (by decide)

/-- PHASE2_SPEC.md §A.1, §A.3 amendment (6) — the composed second record: the sums are exact,
the T-depth is a bound (`gradeExt_assembleCounting`). -/
theorem gradeExt_bound :
    (Synthesis.gradeExt emitted).twoQ = 1161 ∧ (Synthesis.gradeExt emitted).rot = 6 ∧
      (Synthesis.gradeExt emitted).meas = 165 ∧ (Synthesis.gradeExt emitted).ff = 330 ∧
      (Synthesis.gradeExt emitted).tDepth ≤ 660 := by
  have h := gradeExt_assembleCounting h_layer [cg_0, cg_1, cg_2, cg_3] inverse
  simp only [List.zipIdx_cons, List.zipIdx_nil, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Nat.reducePow, Nat.reduceMul, Nat.reduceAdd, h_layer_gradeExt_eq, cg_0_gradeExt_eq, cg_1_gradeExt_eq, cg_2_gradeExt_eq, cg_3_gradeExt_eq, inverse_gradeExt_eq, cg_0_grade_eq, cg_1_grade_eq, cg_2_grade_eq, cg_3_grade_eq, inverse_grade_eq] at h
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  rw [emitted_def]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> omega

/-- The network is well formed (a hypothesis of `ae_parametric_lemma`). -/
theorem hN : net.WF := by decide +kernel

/-- Report §8.2 (Stage 14a) — the solution count, decided by the kernel: `Network.countSat`
evaluates `net` on all 2^8 inputs; `Network.countSat_eq_card` identifies that count with the
cardinality of the statement. -/
theorem hM_count : (Finset.univ.filter fun x => Network.pred net 8 x = true).card = 32 := by
  rw [← Network.countSat_eq_card]
  decide +kernel

/-- PHASE2_SPEC.md §A.4 (amendments before Stage 20b3, (3)), report §2.1.2, §8.4.4 — **the
certificate, universal in the solution count**: for whatever the true count `M ≥ 1` of
`net.pred 8` is, the Grover channel of the emitted counting circuit `(ae_eps (M/2^8) 4,
ae_delta)`-realizes `CountSpec 4 (M/2^8)` under `countPOVM 8 4 (M/2^8)` within the composed
grade bound, and the circuit restores its ancillae while applying `U_count (net.pred 8) 4 none`.
No claim is made for `M = 0`. -/
theorem cert : ∀ M : ℕ, (Finset.univ.filter fun x => Network.pred net 8 x = true).card = M →
    1 ≤ M →
    Realizes (CountSpec 4 (M / 2 ^ 8 : ℝ)) (countPOVM 8 4 (M / 2 ^ 8 : ℝ)) (groverChannel 12 emitted)
        (ae_eps (M / 2 ^ 8 : ℝ) 4) ae_delta ⟨20, 1388, 660, 8⟩ ∧
      AncRestore 12 emitted.nAnc emitted (U_count (Network.pred net 8) 4 none) :=
  fun M hcard hpos =>
    ae_parametric_lemma_mk 8 M hpos (Network.pred net 8) hcard (by decide) hN rfl rfl rfl
      emitted_ok _ grade_le

#print axioms cert

/-- The instance at the kernel-decided count `M = 32` (for the comparison with the Grover
certificate of the same predicate). -/
theorem cert_count :
    Realizes (CountSpec 4 ((32 : ℕ) / 2 ^ 8 : ℝ)) (countPOVM 8 4 ((32 : ℕ) / 2 ^ 8 : ℝ)) (groverChannel 12 emitted)
        (ae_eps ((32 : ℕ) / 2 ^ 8 : ℝ) 4) ae_delta ⟨20, 1388, 660, 8⟩ ∧
      AncRestore 12 emitted.nAnc emitted (U_count (Network.pred net 8) 4 none) :=
  cert 32 hM_count (by decide)

#print axioms cert_count

