/-- The hash link: the kernel re-runs the synthesizer on `net` and compares with `emitted`. -/
theorem emitted_ok : groverCircuit net 8 1 = .ok emitted :=
  except_ok_of_check _ _ (by decide +kernel)

theorem delta_eq : ((groverDelta 1 8 56 : ℚ) : ℝ) = (25 / 2048 : ℝ) := by
  rw [show groverDelta 1 8 56 = (25 / 2048 : ℚ) by decide +kernel]
  norm_num

theorem grade_eq : Synthesis.grade emitted = ⟨20, 159, 76, 12⟩ := by decide +kernel

/-- PHASE2_SPEC.md §A.1 (Stage 17b) — the second resource record of the emitted circuit, measured by
the same scheduler as `grade_eq`: two-qubit gates, T-depth, rotation gates, measurements and
feed-forward gates (`grade_ext` in certificate.json; `cert` does not take it). -/
theorem gradeExt_eq : Synthesis.gradeExt emitted = ⟨281, 27, 0, 19, 38⟩ := by decide +kernel

theorem nAnc_eq : emitted.nAnc = 12 := by decide +kernel

/-- The synthesized oracle of `net`. -/
def oracleCircuit : Circuit := okPayload (synthesizeOracle net)

/-- The oracle certificate (§5.2.4): Lemma 6.3.2 fills its restoration field. -/
def oracle : OracleCert 8 where
  N := net
  C := oracleCircuit
  hn := rfl
  hC := except_eq_ok_okPayload (synthesizeOracle net) (by decide +kernel)
  hWF := by decide +kernel

/-- The MCZ of the V1 diffusion on 8 qubits (balanced AND tree, Stage 12a). -/
def mczCircuit : Circuit := okPayload (synthesizeOracle (treeNet 8))

/-- The diffusion certificate `DiffusionCert 8` (§8.2; `hPred` by `treeNet_pred`). -/
def mcz : DiffusionCert 8 where
  net := treeNet 8
  mcz := {N := treeNet 8, C := mczCircuit, hn := rfl,
           hC := except_eq_ok_okPayload (synthesizeOracle (treeNet 8)) (by decide +kernel),
           hWF := by decide +kernel}
  hN := rfl

/-- Report §8.2 (Stage 14a) — the solution count, decided by the kernel: `Network.countSat`
evaluates `net` on all 2^8 inputs; `Network.countSat_eq_card` identifies that count with the
cardinality of the statement. -/
theorem hM_count : (Finset.univ.filter fun x => Network.pred net 8 x = true).card = 56 := by
  rw [← Network.countSat_eq_card]
  decide +kernel

/-- Report §8.4.1, §8.4.4 — the certificate: the emitted circuit realizes the search spec of
`net` with δ = 25/2048 exactly within its measured grade, and restores its ancillae;
the solution count is decided by the kernel (`hM_count`). -/
theorem cert :
    RealizesExact (SearchSpec (Network.pred net 8)) (basisPOVM 8) (groverChannel 8 emitted)
        (25 / 2048 : ℝ) ⟨20, 159, 76, 12⟩ ∧
      AncRestore 8 12 emitted (groverOp (Network.pred net 8) ^ 1 * hadamardU 8) :=
  grover_certificate oracle mcz (by decide) emitted_ok delta_eq grade_eq nAnc_eq hM_count

#print axioms cert

