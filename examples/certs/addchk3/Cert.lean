/-- The synthesized oracle of `net`. -/
def oracleCircuit : Circuit := okPayload (synthesizeOracle net)

/-- The oracle certificate (§5.2.4): Lemma 6.3.2 fills its restoration field. -/
def oracle : OracleCert 9 where
  N := net
  C := oracleCircuit
  hn := rfl
  hC := except_eq_ok_okPayload (synthesizeOracle net) (by decide +kernel)
  hWF := by decide +kernel

/-- The MCZ of the V1 diffusion on 9 qubits (balanced AND tree, Stage 12a). -/
def mczCircuit : Circuit := okPayload (synthesizeOracle (treeNet 9))

/-- The diffusion certificate `DiffusionCert 9` (§8.2; `hPred` by `treeNet_pred`). -/
def mcz : DiffusionCert 9 where
  net := treeNet 9
  mcz := {N := treeNet 9, C := mczCircuit, hn := rfl,
           hC := except_eq_ok_okPayload (synthesizeOracle (treeNet 9)) (by decide +kernel),
           hWF := by decide +kernel}
  hN := rfl

/-- Report §8.2 (Stage 14a) — the solution count, decided by the kernel: `Network.countSat`
evaluates `net` on all 2^9 inputs; `Network.countSat_eq_card` identifies that count with the
cardinality of the statement. -/
theorem hM_count : (Finset.univ.filter fun x => Network.pred net 9 x = true).card = 64 := by
  rw [← Network.countSat_eq_card]
  decide +kernel

/-- Report §8.4.1, §8.4.4 — the certificate: the emitted circuit realizes the search spec of
`net` with δ = 7/128 exactly within its measured grade, and restores its ancillae;
the solution count is decided by the kernel (`hM_count`). -/
theorem cert :
    RealizesExact (SearchSpec (Network.pred net 9)) (basisPOVM 9) (groverChannel 9 emitted)
        (7 / 128 : ℝ) ⟨17, 226, 104, 8⟩ ∧
      AncRestore 9 8 emitted (groverOp (Network.pred net 9) ^ 2 * hadamardU 9) :=
  grover_certificate oracle mcz (by decide) emitted_ok delta_eq grade_eq nAnc_eq hM_count

#print axioms cert

