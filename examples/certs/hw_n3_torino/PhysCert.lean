  except_ok_of_check _ _ (by decide +kernel)

theorem delta_eq : ((groverDelta 2 3 1 : ℚ) : ℝ) = (7 / 128 : ℝ) := by
  rw [show groverDelta 2 3 1 = (7 / 128 : ℚ) by decide +kernel]
  norm_num

theorem grade_eq : Synthesis.grade emitted = ⟨5, 110, 32, 2⟩ := by decide +kernel

/-- PHASE2_SPEC.md §A.1 (Stage 17b) — the second resource record of the emitted circuit, measured by
the same scheduler as `grade_eq`: two-qubit gates, T-depth, rotation gates, measurements and
feed-forward gates (`grade_ext` in certificate.json; `cert` does not take it). -/
theorem gradeExt_eq : Synthesis.gradeExt emitted = ⟨56, 23, 0, 8, 16⟩ := by decide +kernel

theorem nAnc_eq : emitted.nAnc = 2 := by decide +kernel

/-- The synthesized oracle of `net`. -/
def oracleCircuit : Circuit := okPayload (synthesizeOracle net)

/-- The oracle certificate (§5.2.4): Lemma 6.3.2 fills its restoration field. -/
def oracle : OracleCert 3 where
  N := net
  C := oracleCircuit
  hn := rfl
  hC := except_eq_ok_okPayload (synthesizeOracle net) (by decide +kernel)
  hWF := by decide +kernel

/-- The MCZ of the V1 diffusion on 3 qubits (balanced AND tree, Stage 12a). -/
def mczCircuit : Circuit := okPayload (synthesizeOracle (treeNet 3))

/-- The diffusion certificate `DiffusionCert 3` (§8.2; `hPred` by `treeNet_pred`). -/
def mcz : DiffusionCert 3 where
  net := treeNet 3
  mcz := {N := treeNet 3, C := mczCircuit, hn := rfl,
           hC := except_eq_ok_okPayload (synthesizeOracle (treeNet 3)) (by decide +kernel),
           hWF := by decide +kernel}
  hN := rfl

/-- Report §8.2 (Stage 14a) — the solution count, decided by the kernel: `Network.countSat`
evaluates `net` on all 2^3 inputs; `Network.countSat_eq_card` identifies that count with the
cardinality of the statement. -/
theorem hM_count : (Finset.univ.filter fun x => Network.pred net 3 x = true).card = 1 := by
  rw [← Network.countSat_eq_card]
  decide +kernel

/-- Report §8.4.1, §8.4.4 — the certificate: the emitted circuit realizes the search spec of
`net` with δ = 7/128 exactly within its measured grade, and restores its ancillae;
the solution count is decided by the kernel (`hM_count`). -/
theorem cert :
    RealizesExact (SearchSpec (Network.pred net 3)) (basisPOVM 3) (groverChannel 3 emitted)
        (7 / 128 : ℝ) ⟨5, 110, 32, 2⟩ ∧
      AncRestore 3 2 emitted (groverOp (Network.pred net 3) ^ 2 * hadamardU 3) :=
  grover_certificate oracle mcz (by decide) emitted_ok delta_eq grade_eq nAnc_eq hM_count

#print axioms cert

