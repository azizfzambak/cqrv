theorem ps_eq : (noiseProbs rates dev G).toOption = some ps := by decide +kernel

/-- (P-ro): the readout rates `r_j` of the 3 data qubits at the final layout (`readoutRates`). -/
def rs : List Rat := [mkRat 83 2048, mkRat 355 4096, mkRat 37 1024]

theorem rs_eq : (readoutRates rates dataPhys).toOption = some rs := by decide +kernel

/-- **The conditional bound** `δ' = δ + Σ p_g + Σ r_j` (exact; ≈ 0.752054). -/
def noiseB : Rat := 37602683667012271437/50000000000000000000

theorem noiseBound_eq : (noiseBound rates dev G dataPhys delta).toOption =
    some ⟨noiseB, false, false⟩ := by decide +kernel

/-- The identity behind the real bound of the noise theorem, decided by the kernel. -/
theorem noise_key : delta + ((ps.map clamp01).sum + (rs.map clamp01).sum) = noiseB := by decide +kernel

theorem delta_cast : ((delta : Rat) : ℝ) = (7/128 : ℝ) := by norm_num [delta]

/-- **`phys_noisy_inst`**: under (P-stoch) at the basis operations with the probabilities `ps`, (P-ro) at
the data readouts with the rates `rs`, and (P-idle) (only the listed steps act), **for every choice of
the arbitrary channels** (the third components of `T` and the second of `R`), the noisy physical
channel `RealizesExact` the specification with `δ' = noiseB`, at the physical circuit's grade
(`phys_noisy_inst_of`, through `emitted_eq`). Conditional on the premises; not a fact about a device. -/
theorem phys_noisy_inst
    (T : List (BasisGate × Prob × CPTPMap (XReg (C.nData + (C.nAnc + bb)) 0 (physCircuit (C.nData + (C.nAnc + bb)) G).nBits) (XReg (C.nData + (C.nAnc + bb)) 0 (physCircuit (C.nData + (C.nAnc + bb)) G).nBits))) (hT : T.map (·.1) = G)
    (hp : T.map (·.2.1) = ps.map probOfRat)
    (R : List (Prob × CPTPMap (XReg (C.nData + (C.nAnc + bb)) 0 (physCircuit (C.nData + (C.nAnc + bb)) G).nBits) (XReg (C.nData + (C.nAnc + bb)) 0 (physCircuit (C.nData + (C.nAnc + bb)) G).nBits))) (hR : R.map (·.1) = rs.map probOfRat) :
    ∃ σf' : Equiv.Perm (Fin (C.nData + (C.nAnc + bb))), W.final = layOf (C.nData + (C.nAnc + bb)) (C.nData + C.nAnc) σf' ∧
      RealizesExact (SearchSpec (Network.pred net 3)) (basisPOVM 3)
        ⟨unembed bb σf' ∘ₘ CPTPMap.traceRight ∘ₘ
            steps (stochasticSteps (C.nData + (C.nAnc + bb)) (physCircuit (C.nData + (C.nAnc + bb)) G).nBits T R) ∘ₘ
            physPrep (C.nData + (C.nAnc + bb)) (physCircuit (C.nData + (C.nAnc + bb)) G).nBits (embed bb σ₀ (ancZero C.nData ⊗ᴹ ancZero C.nAnc)),
          Synthesis.grade (physCircuit (C.nData + (C.nAnc + bb)) G)⟩
        ((noiseB : Rat) : ℝ) (Synthesis.grade (physCircuit (C.nData + (C.nAnc + bb)) G)) :=
  phys_noisy_inst_of .cz C W bb c_wf G (applyWitnessQ_ok _ _ c_wf _ _ _ recon) phys_wf
    phys_nBits σ₀ init_eq _ _ _ _ (emitted_eq ▸ cert.1) T hT ps hp R rs hR delta noiseB delta_cast noise_key

#print axioms phys_noisy_inst

#print axioms emitted_eq
