def oracle : OracleCert 8 where
  N := net
  C := oracleCircuit
  hn := rfl
  hC := except_eq_ok_okPayload (synthesizeOracle net) (by decide +kernel)
  hWF := by decide +kernel

/-- The few-ancilla MCZ on 8 qubits (Stage 12b candidate B; `mczFewK` is `mczFew` with a
kernel-evaluable sort, `mczFew_eq_K`). -/
def mczCircuit : Circuit := okPayload (mczFewK 8 .logDepth)

theorem mcz_ok : mczFew 8 .logDepth = .ok mczCircuit := by
  rw [mczFew_eq_K]
  exact except_eq_ok_okPayload (mczFewK 8 .logDepth) (by decide +kernel)

theorem mcz_WF : mczCircuit.WF := by decide +kernel

theorem mcz_nBits : mczCircuit.nBits = nAnd (MczFew.plan 8 .logDepth).1 := by
  rw [FewSchedule.plan_eq_planK]
  decide +kernel

theorem mcz_nAnc : 2 ≤ mczCircuit.nAnc := by decide +kernel

/-- The classical step (Stage 12d decision 1), KG Theorem 5.1 for n = 8 on `Reg 8 × Reg 2`:
the steps pass the qubit checks and, for each of the 256 inputs, every AND target is clean
when computed and the qubits of the final `CZ` multiply to `x₀ ∧ … ∧ x_7`. -/
theorem classical_step : fewCheck 8 2 (MczFew.plan 8 .logDepth) = true := by
  rw [FewSchedule.plan_eq_planK]
  decide +kernel

/-- The few-ancilla diffusion on 8 qubits (§8.2). -/
def diffCircuit : Circuit := diffusionCircuit 8 mczCircuit

theorem diff_ok : diffusionFew 8 .logDepth = .ok diffCircuit := diffusionFew_ok_of mcz_ok

theorem diff_WF : diffCircuit.WF := by decide +kernel

/-- The hash link: the Grover circuit of `groverCircuitFew` is `groverCircuitOf` the oracle and
the diffusion; the kernel compares it with `emitted`. -/
theorem emitted_ok : groverCircuitFew net 8 2 .logDepth = .ok emitted :=
  (groverCircuitFew_ok_of oracle.hn oracle.hC mcz_ok).trans (congrArg Except.ok (by decide +kernel))

/-- Report §8.4.1, §8.4.4 — the certificate: the emitted circuit realizes the search spec of
`net` with δ = 7/128 exactly within its measured grade, and restores its ancillae; conditional
on the solution count `hM_card`. -/
theorem cert
    (hM_card : (Finset.univ.filter fun x => Network.pred net 8 x = true).card = 32) :
    RealizesExact (SearchSpec (Network.pred net 8)) (basisPOVM 8) (groverChannel 8 emitted)
        (7 / 128 : ℝ) ⟨10, 172, 96, 2⟩ ∧
      AncRestore 8 2 emitted (groverOp (Network.pred net 8) ^ 2 * hadamardU 8) :=
  grover_certificate_few oracle (by decide) mcz_ok mcz_WF mcz_nBits classical_step mcz_nAnc
    diff_ok diff_WF emitted_ok delta_eq grade_eq nAnc_eq hM_card

