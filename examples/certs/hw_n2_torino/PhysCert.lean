# Physical certificate `hw_n2_torino` (generated by `cqr hw certify`; do not edit)

Report §5.3, §8.4, §9.1.1; PHASE2_SPEC §C.3 (Stage 26c2). The committed logical certificate
`CQRV.Cert.«hw_n2»` (certificate.json SHA3-256 modulo `hashes.library` `2e5a734f925b2e91657ce6fce2f7a0d9aeb157338d3b9f0bc15d4788342c3856`; `circuit_hash`
`0734c030471e700f23fcb00c4ca7ffd707fbf1de345674b70c4522a0200894fe`), re-derived verbatim below on its `emitted` literal, and the artifact
`hw/artifacts/hw_n2_tree_mbu__fake_torino/` (`logical.json` SHA3-256 `0734c030471e700f23fcb00c4ca7ffd707fbf1de345674b70c4522a0200894fe`,
`witness.json` `e213f51a9bac100d984c9773a9d800a12916000552e08af09608bf94ec16ccd1`, `physical.json` `d4aff9f3e987c31d030cc8ac0111894da7ca9e825a348ee85059112d732daedc`), on the target `fake_torino`
(`hw/targets/fake_torino.json`: snapshot `bed94fe37b44870f5a7d144a730bda1d3bf4782c0735430e2c8f069b0e6b33e1`, file bytes SHA3-256 `2bf20c70d7d6fc68583c074ef316a3e82a1d7d8f28f769efa3fac962819fd40c` — the
durations are outside the snapshot hash), compacted to the 3 used qubits `[80, 92, 99]`.

**The trusted link** is `emitted_eq : emitted = C`, decided by the kernel: the artifact's logical
circuit is the certified circuit. **The physical statement** (`phys_realizes`): on an ideal device
with the target's gates and coupling map, started from all-|0⟩ on its used qubits, the physical
circuit realizes the specification with the certified δ, at the physical circuit's own grade.
**The grade** (`PhysGrade`) is evaluated by the kernel at the stated feed-forward latencies; the
bound is a sum of calibrated rates (reported, not certified: Stage 27 is the noise theorem).
Nothing here is "verified on hardware"; noise is not addressed. Status: logical_certified, hardware_compatible, physical_translation_validated, noise_conditional, emulator_sanity_checked.
-/

set_option maxRecDepth 100000

namespace CQRV.Cert.«hw_n2»

open CQRV CQRV.Synthesis CQRV.Grover CQRV.Certify

/-- The Boolean network of the request (`toNetwork`, §6.1.2). -/
def net : Network := ⟨2, #[
    .input 0, .input 1, .and 0 1],
  [2]⟩

/-- The typed term of the request (report §7.2.2; Stage 16b): the output of the surface checker as
a Lean literal (`TypedProgram.renderLean`, an unverified printer; `net_ok` ties it to `net`). -/
def prog : DSL.TypedProgram :=
  { name := "hw_n2", params := [("x", (.vec 2))], ret := .bool,
    body := (.and (.idx (n := 2) (.var "x" (.vec 2)) (.lit ⟨0, by decide⟩)) (.idx (n := 2) (.var "x" (.vec 2)) (.lit ⟨1, by decide⟩))) }

/-- Report §7.2 (Stage 16a) — `prog` is scoped: the hypothesis of the front-end theorems. -/
theorem prog_scoped : prog.scoped = true := by decide

/-- The front-end link (Stage 16b): the kernel re-runs the translation `toNetwork` on `prog` and
compares with `net`. -/
theorem net_ok : toNetwork prog = .ok net := except_ok_of_check _ _ (by decide +kernel)

/-- Report §7.2–7.4, §5.3.3 (Stage 16b) — the front end at this instance: the reference evaluator on
`prog` agrees with the predicate of `net` on every input (`toNetwork_pred`, Stage 16a). -/
theorem front_end : ∀ x : Fin 2 → Bool, DSL.evalProgram prog x = Network.pred net 2 x :=
  fun x => (toNetwork_pred prog net net_ok prog_scoped x).symm

#print axioms front_end

/-- The emitted circuit (IR, §6.1.4): QIR / OpenQASM 3 and `circuit_hash` are of this literal. -/
def emitted : Circuit := ⟨2, [
    .h (.data 0), .h (.data 1), .alloc (.anc 0), .h (.anc 0), .t (.anc 0),
    .cnot (.data 0) (.anc 0), .cnot (.data 1) (.anc 0), .cnot (.anc 0) (.data 0), .cnot (.anc 0) (.data 1), .tdg (.data 0),
    .tdg (.data 1), .t (.anc 0), .cnot (.anc 0) (.data 0), .cnot (.anc 0) (.data 1), .h (.anc 0),
    .s (.anc 0), .z (.anc 0), .h (.anc 0), .measure (.anc 0) 0, .ifBit 0 (.cz (.data 0) (.data 1)),
    .ifBit 0 (.x (.anc 0)), .free (.anc 0), .h (.data 0), .h (.data 1), .x (.data 0),
    .x (.data 1), .alloc (.anc 0), .h (.anc 0), .t (.anc 0), .cnot (.data 0) (.anc 0),
    .cnot (.data 1) (.anc 0), .cnot (.anc 0) (.data 0), .cnot (.anc 0) (.data 1), .tdg (.data 0), .tdg (.data 1),
    .t (.anc 0), .cnot (.anc 0) (.data 0), .cnot (.anc 0) (.data 1), .h (.anc 0), .s (.anc 0),
    .z (.anc 0), .h (.anc 0), .measure (.anc 0) 1, .ifBit 1 (.cz (.data 0) (.data 1)), .ifBit 1 (.x (.anc 0)),
    .free (.anc 0), .x (.data 0), .x (.data 1), .h (.data 0), .h (.data 1)]⟩

/-- The hash link: the kernel re-runs the synthesizer on `net` and compares with `emitted`. -/
theorem emitted_ok : groverCircuit net 2 1 = .ok emitted :=
  except_ok_of_check _ _ (by decide +kernel)

theorem delta_eq : ((groverDelta 1 2 1 : ℚ) : ℝ) = (0 / 1 : ℝ) := by
  rw [show groverDelta 1 2 1 = (0 / 1 : ℚ) by decide +kernel]
  norm_num

theorem grade_eq : Synthesis.grade emitted = ⟨3, 32, 8, 1⟩ := by decide +kernel

/-- PHASE2_SPEC.md §A.1 (Stage 17b) — the second resource record of the emitted circuit, measured by
the same scheduler as `grade_eq`: two-qubit gates, T-depth, rotation gates, measurements and
feed-forward gates (`grade_ext` in certificate.json; `cert` does not take it). -/
theorem gradeExt_eq : Synthesis.gradeExt emitted = ⟨14, 6, 0, 2, 4⟩ := by decide +kernel

theorem nAnc_eq : emitted.nAnc = 1 := by decide +kernel

/-- The synthesized oracle of `net`. -/
def oracleCircuit : Circuit := okPayload (synthesizeOracle net)

/-- The oracle certificate (§5.2.4): Lemma 6.3.2 fills its restoration field. -/
def oracle : OracleCert 2 where
  N := net
  C := oracleCircuit
  hn := rfl
  hC := except_eq_ok_okPayload (synthesizeOracle net) (by decide +kernel)
  hWF := by decide +kernel

/-- The MCZ of the V1 diffusion on 2 qubits (balanced AND tree, Stage 12a). -/
def mczCircuit : Circuit := okPayload (synthesizeOracle (treeNet 2))

/-- The diffusion certificate `DiffusionCert 2` (§8.2; `hPred` by `treeNet_pred`). -/
def mcz : DiffusionCert 2 where
  net := treeNet 2
  mcz := {N := treeNet 2, C := mczCircuit, hn := rfl,
           hC := except_eq_ok_okPayload (synthesizeOracle (treeNet 2)) (by decide +kernel),
           hWF := by decide +kernel}
  hN := rfl

/-- Report §8.2 (Stage 14a) — the solution count, decided by the kernel: `Network.countSat`
evaluates `net` on all 2^2 inputs; `Network.countSat_eq_card` identifies that count with the
cardinality of the statement. -/
theorem hM_count : (Finset.univ.filter fun x => Network.pred net 2 x = true).card = 1 := by
  rw [← Network.countSat_eq_card]
  decide +kernel

/-- Report §8.4.1, §8.4.4 — the certificate: the emitted circuit realizes the search spec of
`net` with δ = 0 exactly within its measured grade, and restores its ancillae;
the solution count is decided by the kernel (`hM_count`). -/
theorem cert :
    RealizesExact (SearchSpec (Network.pred net 2)) (basisPOVM 2) (groverChannel 2 emitted)
        (0 / 1 : ℝ) ⟨3, 32, 8, 1⟩ ∧
      AncRestore 2 1 emitted (groverOp (Network.pred net 2) ^ 1 * hadamardU 2) :=
  grover_certificate oracle mcz (by decide) emitted_ok delta_eq grade_eq nAnc_eq hM_count

#print axioms cert

end CQRV.Cert.«hw_n2»

