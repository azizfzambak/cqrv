/-- The idle qubits of the compact register. -/
abbrev bb : ℕ := 1

theorem nData_eq : C.nData = 8 := rfl
theorem nAnc_eq : C.nAnc = 7 := by decide +kernel
theorem reg_eq : (C.nData + (C.nAnc + bb)) = 16 := by decide +kernel
theorem c_wf : C.WF := by decide +kernel

/-- **`recon`**: the linear check reconstructs the artifact's physical circuit exactly (the kernel
evaluates `applyWitnessQ`). -/
theorem recon : applyWitnessQ .cz C W (C.nData + (C.nAnc + bb)) = .ok G := by rfl

theorem phys_wf : (physCircuit (C.nData + (C.nAnc + bb)) G).WF := by decide +kernel
theorem phys_nBits : (physCircuit (C.nData + (C.nAnc + bb)) G).nBits = C.nBits := by decide +kernel

/-- **`edges_ok`**: every two-qubit gate of `G` lies on a coupling edge of the target. -/
theorem edges_ok : edgesOk G dev edges = true := by decide +kernel

theorem init_layout : IsLayout (C.nData + (C.nAnc + bb)) (C.nData + C.nAnc) W.initial := by decide +kernel

/-- The initial layout as a permutation of the compact register. -/
noncomputable def σ₀ : Equiv.Perm (Fin (C.nData + (C.nAnc + bb))) := layPerm _ (C.nData + C.nAnc) W.initial

theorem init_eq : W.initial = layOf (C.nData + (C.nAnc + bb)) (C.nData + C.nAnc) σ₀ := (layOf_layPerm _ _ _ init_layout).symm

/-- The final layout as a permutation: the SWAPs of the reconstruction applied to `σ₀`. -/
noncomputable def σf : Equiv.Perm (Fin (C.nData + (C.nAnc + bb))) := finalPerm .cz C W _ σ₀

/-- **`phys_channel`** (`applyWitness_sound` at this instance, through `applyWitnessQ_ok`): on the
embedded input laid out by `σ₀`, the physical circuit gives the embedded output of `C` laid out by
`σf`, which extends the witness's final layout. -/
theorem phys_channel :
    W.final = layOf (C.nData + (C.nAnc + bb)) (C.nData + C.nAnc) σf ∧
      ∀ ρ : MState (Reg C.nData × Reg C.nAnc),
        channelDenote (C.nData + (C.nAnc + bb)) 0 (physCircuit (C.nData + (C.nAnc + bb)) G) (embed bb σ₀ ρ) =
          embed bb σf (channelDenote C.nData C.nAnc C ρ) :=
  applyWitnessQ_sound .cz C W bb c_wf G recon phys_wf phys_nBits σ₀ init_eq

/-- **`phys_zero`**: from the all-|0⟩ physical state (the state the device starts from), the
output is `σf`'s embedding of the logical output from |0⟩. -/
theorem phys_zero :
    channelDenote (C.nData + (C.nAnc + bb)) 0 (physCircuit (C.nData + (C.nAnc + bb)) G) (ancZero (C.nData + (C.nAnc + bb)) ⊗ᴹ ancZero 0) =
      embed bb σf (channelDenote C.nData C.nAnc C (ancZero C.nData ⊗ᴹ ancZero C.nAnc)) := by
  rw [← embed_zero bb σ₀]
  exact phys_channel.2 _

/-- `G` with its first gate changed is not the reconstruction. -/
theorem tamper_recon : applyWitnessQ .cz C W (C.nData + (C.nAnc + bb)) ≠ .ok (G.set 0 (.sx (.data 0))) := by
  rw [recon]
  intro h
  exact absurd (Except.ok.inj h) (by decide +kernel)

/-- A two-qubit gate on compact qubits 0, 1 (device 35, 42), not an edge, is refused. -/
theorem tamper_edges : edgesOk (G ++ [.cz (.data 0) (.data 1)]) dev edges = false := by decide +kernel

/-- **The trusted link**: the artifact's logical circuit is the certificate's emitted circuit. -/
theorem emitted_eq : emitted = C := by decide +kernel

/-- The start state of the device, all-|0⟩, is the embedded logical |0⟩ for the initial layout. -/
theorem phys_start : embed bb σ₀ (ancZero C.nData ⊗ᴹ ancZero C.nAnc) = ancZero (C.nData + (C.nAnc + bb)) ⊗ᴹ ancZero 0 :=
  embed_zero bb σ₀

/-- **`phys_realizes`**: the certified realization transferred to the physical circuit
(`realizesExact_phys` through `emitted_eq`), from the all-|0⟩ physical state (`physGroverChannel`
prepares `embed bb σ₀ |0⟩`, which `phys_start` identifies), with the same decoding, at the physical
circuit's own grade. -/
theorem phys_realizes :
    ∃ σf' : Equiv.Perm (Fin (C.nData + (C.nAnc + bb))), W.final = layOf (C.nData + (C.nAnc + bb)) (C.nData + C.nAnc) σf' ∧
      RealizesExact (SearchSpec (Network.pred net 8)) (basisPOVM 8)
        (physGroverChannel bb σ₀ σf' (physCircuit (C.nData + (C.nAnc + bb)) G)) (7/128 : ℝ)
        (Synthesis.grade (physCircuit (C.nData + (C.nAnc + bb)) G)) :=
  realizesExact_phys .cz C W bb c_wf G (applyWitnessQ_ok _ _ c_wf _ _ _ recon) phys_wf
    phys_nBits σ₀ init_eq _ _ _ _ (emitted_eq ▸ cert.1)

