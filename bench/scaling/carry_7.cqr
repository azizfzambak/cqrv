fn carry_7(x: Vec Bool 14) -> Bool {
  let c0 = idx(x, 0) and idx(x, 7) in
  let c1 = (idx(x, 1) and idx(x, 8)) xor (c0 and (idx(x, 1) xor idx(x, 8))) in
  let c2 = (idx(x, 2) and idx(x, 9)) xor (c1 and (idx(x, 2) xor idx(x, 9))) in
  let c3 = (idx(x, 3) and idx(x, 10)) xor (c2 and (idx(x, 3) xor idx(x, 10))) in
  let c4 = (idx(x, 4) and idx(x, 11)) xor (c3 and (idx(x, 4) xor idx(x, 11))) in
  let c5 = (idx(x, 5) and idx(x, 12)) xor (c4 and (idx(x, 5) xor idx(x, 12))) in
  let c6 = (idx(x, 6) and idx(x, 13)) xor (c5 and (idx(x, 6) xor idx(x, 13))) in
  c6
}
