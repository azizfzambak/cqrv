-- Stage 14b, family alu_bits: RevLib Simple ALU (simple_alu_234.src), bit 2 of x0;
-- transcription rules of examples/simple_alu_x0_1.cqr (DECISIONS.md 2026-10-25).
-- Input layout: x[0] = op.0, x[1] = op.1, x[2..4] = x1.0..2, x[5..7] = x2.0..2.
fn simple_alu_x0_2(x: Vec Bool 8) -> Bool {
  let op0 = idx(x, 0) in
  let op1 = idx(x, 1) in
  let a0 = idx(x, 2) in
  let a1 = idx(x, 3) in
  let a2 = idx(x, 4) in
  let b0 = idx(x, 5) in
  let b1 = idx(x, 6) in
  let b2 = idx(x, 7) in
  if (not op1) and (not op0) then a2 xor b2 xor ((a1 and b1) xor ((a0 and b0) and (a1 xor b1)))
  else if (not op1) and op0 then a2 xor b2 xor (((not a1) and b1) xor (((not a0) and b0) and (not (a1 xor b1))))
  else if op1 and (not op0) then (a0 and b2) xor (a1 and b1) xor (a2 and b0) xor ((a0 and b1) and (a1 and b0))
  else a2 xor b2
}
